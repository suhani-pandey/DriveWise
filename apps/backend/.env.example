NODE_ENV=development
PORT=8000

# Optional — the API runs on in-memory data without it.
# Set to enable the Postgres/Drizzle adapter.
DATABASE_URL=

# Optional — AI answers fall back to a deterministic heuristic without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — Danish number-plate lookup (Motorregister data via https://nrpla.de).
NRPLADE_API_TOKEN=
NRPLADE_BASE_URL=https://api.nrpla.de

# Free VIN decoding (no key needed).
VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api

CLERK_SECRET_KEY=
CLERK_JWKS_URL=

CORS_ORIGIN=http://localhost:3000
